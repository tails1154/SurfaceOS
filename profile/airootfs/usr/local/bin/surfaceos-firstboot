#!/usr/bin/env bash
set -euo pipefail

systemctl enable NetworkManager.service
systemctl enable bluetooth.service
systemctl enable power-profiles-daemon.service
systemctl enable iio-sensor-proxy.service
systemctl enable tlp.service || true
systemctl enable sddm.service
systemctl enable surfaceos-live-setup.service

if id liveuser >/dev/null 2>&1; then
  install -d -m 0700 -o liveuser -g liveuser /home/liveuser/.config
  install -d -m 0700 -o liveuser -g liveuser /home/liveuser/Desktop
  install -d -m 0700 -o liveuser -g liveuser /home/liveuser/.local/share/applications
fi
